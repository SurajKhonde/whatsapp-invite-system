{
  "extends": "../../tsconfig.json",

  "compilerOptions": {
    "target": "ES2020",
    "module": "commonjs",

    "rootDir": ".",
    "outDir": "dist",

    "strict": true,
    "esModuleInterop": true,

    "baseUrl": ".", 
    "ignoreDeprecations": "6.0",

    "paths": {
      "@config/*": ["src/config/*"],
      "@core/*": ["src/core/*"],
      "@modules/*": ["src/modules/*"],
      "@db/*": ["db/*"]
    }
  },

  "include": ["src", "db"]
}