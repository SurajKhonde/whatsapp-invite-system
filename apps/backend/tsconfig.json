{
  "compilerOptions": {
    "target": "ES2020",
    "module": "commonjs",

    "rootDir": ".",
    "outDir": "dist",

    "strict": true,
    "esModuleInterop": true,

    "baseUrl": ".",

    "skipLibCheck": true,

    "paths": {
      "@config/*": ["src/config/*"],
      "@core/*": ["src/core/*"],
      "@modules/*": ["src/modules/*"],
      "@queue/*": ["src/core/queue/*"],
      "@workers/*": ["src/core/workers/*"],
      "@templates/*": ["src/HTML-template/*"],
      "@middlewares/*": ["src/middlewares/*"],
      "@utils/*": ["src/utils/*"],
      "@/db/*": ["src/db/*"]
    }
  },

  "include": ["src", "db"]
}