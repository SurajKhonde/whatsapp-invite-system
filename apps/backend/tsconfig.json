{
  "extends": "../../tsconfig.json",

  "compilerOptions": {
    "target": "ES2020",
    "module": "commonjs",
    "rootDir": ".",
    "outDir": "dist",

    "strict": true,
    "esModuleInterop": true,

    "baseUrl": ".", 
    "ignoreDeprecations": "6.0",

    "paths": {
      "@config/*": ["src/config/*"],
      "@core/*": ["src/core/*"],
      "@modules/*": ["src/modules/*"],
      "@queue/*": ["src/core/queue/*"],
      "@workers/*": ["src/core/workers/*"],
      "@templates/*": ["src/HTML-template/*"],
      "@middlewares/*": ["src/middlewares/*"],
      "@utils/*": ["src/utils/*"],
      "@/db/*": ["src/db/*"]

    }
  },

  "include": ["src", "db"]
}