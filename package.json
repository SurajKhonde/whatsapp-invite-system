{
  "name": "whatsapp-invite-system",
  "private": true,
  "version": "1.0.0",
  "description": "Scalable async notification system using Next.js, BullMQ, Redis, and PostgreSQL",
  "author": "Suraj Khonde",
  "license": "MIT",
  "scripts": {
    "dev": "pnpm dev:web & pnpm dev:worker",
    "dev:web": "pnpm --filter web dev",
    "dev:worker": "pnpm --filter worker start",
    "build": "pnpm --filter web build",
    "start": "pnpm --filter web start",
    "worker": "pnpm --filter worker start",
    "db:generate": "prisma generate",
    "db:migrate": "prisma migrate dev"
  },
  "keywords": [
    "nextjs",
    "bullmq",
    "redis",
    "prisma",
    "postgresql",
    "queue",
    "worker",
    "scalable-system"
  ],
  "devDependencies": {
    "@types/node": "^25.6.0",
    "concurrently": "^9.2.1",
    "ts-node": "^10.9.2",
    "typescript": "^6.0.2"
  },
  "dependencies": {
    "bullmq": "^5.73.4",
    "dotenv": "^16.4.5",
    "ioredis": "^5.10.1"
  }
}